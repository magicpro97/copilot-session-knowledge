<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.copilot.browse-backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>-c</string>
        <string>
import sys; sys.argv = ['browse','--port','8765','--hosted-bootstrap','--debug-log']
from browse import main; main()
</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.copilot/tools</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.copilot/session-state/.browse-backend.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.copilot/session-state/.browse-backend.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
