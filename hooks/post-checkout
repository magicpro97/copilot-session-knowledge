#!/usr/bin/env python3
"""Git post-checkout hook — warm briefing prefetch cache on branch switch (issue #818).

Git calls this hook as: post-checkout <prev-sha> <new-sha> <flag>
  flag=1 → branch checkout (fire prefetch)
  flag=0 → file checkout (skip)

The hook fires briefing.py --prefetch in the background (non-blocking) so the
next `sk briefing --auto` call can be served from cache instantly.
"""

import os
import subprocess
import sys
from pathlib import Path

if os.name == "nt":
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            _stream.reconfigure(encoding="utf-8", errors="replace")

# Git passes three args: prev-sha new-sha checkout-flag (1=branch, 0=file)
_args = sys.argv[1:]
_checkout_flag = _args[2] if len(_args) >= 3 else "1"

if _checkout_flag != "1":
    # File-level checkout — no need to warm the cache
    sys.exit(0)

_TOOLS_DIR = Path.home() / ".copilot" / "tools"
_BRIEFING = _TOOLS_DIR / "briefing.py"

if not _BRIEFING.is_file():
    # Tools not installed — silently skip
    sys.exit(0)

# Fire-and-forget: launch briefing.py --prefetch detached from this process.
# On POSIX, nohup + redirect stderr to /dev/null keeps the hook fast.
# On Windows, use DETACHED_PROCESS creation flag.
try:
    if os.name == "nt":
        DETACHED_PROCESS = 0x00000008
        subprocess.Popen(
            [sys.executable, str(_BRIEFING), "--prefetch"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            creationflags=DETACHED_PROCESS,
        )
    else:
        subprocess.Popen(
            [sys.executable, str(_BRIEFING), "--prefetch"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
except Exception:
    pass  # fail-open: hook must never block or fail the checkout

sys.exit(0)
