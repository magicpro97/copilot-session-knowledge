#!/usr/bin/env python3
"""Git pre-commit hook for session-knowledge tools.

Fail-open checks are skipped when optional tooling is absent. Hard blockers:
fresh dispatched-subagent marker, staged Python syntax errors, and hook/skill
lint errors.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

if os.name == "nt":
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            _stream.reconfigure(encoding="utf-8", errors="replace")

TOOLS_DIR = Path.home() / ".copilot" / "tools"
SUBAGENT_CHECK = TOOLS_DIR / "hooks" / "check_subagent_marker.py"
SYNTAX_CHECKER = TOOLS_DIR / "scripts" / "check_syntax.py"
COMPLEXITY_CHECKER = TOOLS_DIR / "scripts" / "check_complexity.py"
LINT_SKILLS = TOOLS_DIR / "hooks" / "lint-skills.py"


def run(args: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(args, text=True, encoding="utf-8", errors="replace", **kwargs)


def git_lines(*args: str) -> list[str]:
    try:
        result = run(["git", *args], capture_output=True, timeout=10)
    except Exception:
        return []
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def staged_files() -> list[str]:
    return git_lines("diff", "--cached", "--name-only", "--diff-filter=ACM")


def staged_content(path: str) -> str:
    try:
        result = run(["git", "show", f":{path}"], capture_output=True, timeout=10)
    except Exception:
        return ""
    return result.stdout if result.returncode == 0 else ""


def run_subagent_guard() -> int:
    if not SUBAGENT_CHECK.is_file():
        return 0
    try:
        return run([sys.executable, str(SUBAGENT_CHECK)], timeout=10).returncode
    except Exception:
        return 0


def check_inline_styles(staged: list[str]) -> int:
    changed_routes = [f for f in staged if f.startswith("browse/routes/") and f.endswith(".py")]
    violators: list[str] = []
    for path in changed_routes:
        content = staged_content(path)
        style_count = content.count("<style")
        if style_count == 0:
            continue
        if path == "browse/routes/dashboard.py" and style_count == 1 and ".db-chart-wrap" in content:
            continue
        violators.append(path)
    if violators:
        print(f"✖ Pre-commit: inline <style> blocks detected in routes: {' '.join(violators)}")
        print("  Move CSS to browse/static/css/app.css. This is enforced by test_no_inline_style_in_routes().")
        return 1
    return 0


def check_python_syntax(staged: list[str]) -> int:
    if not SYNTAX_CHECKER.is_file():
        return 0
    staged_py = [f for f in staged if f.endswith(".py")]
    if not staged_py:
        return 0
    print("🐍 Checking Python syntax (check_syntax.py)...")
    failed = False
    for path in staged_py:
        try:
            result = run([sys.executable, str(SYNTAX_CHECKER), path], capture_output=True, timeout=20)
        except Exception as exc:
            print(exc)
            failed = True
            continue
        if result.returncode != 0:
            failed = True
            output = (result.stdout + result.stderr).strip()
            if output:
                print(output)
    if failed:
        print("✖ Syntax errors detected in staged files. Fix them before committing.")
        return 1
    return 0


# Canonical surface inventory: docs/ARCHITECTURE.md#python-lint-surface-inventory
# Keep this in sync with .github/workflows/ci.yml and tests/test_quality_gates.py.
def in_python_cleanliness_surface(path: str) -> bool:
    exact = {
        "embed.py",
        "scout-config.py",
        "scout-status.py",
        "sync-config.py",
        "sync-daemon.py",
        "sync-status.py",
        "migrate.py",
        "generate-summary.py",
        "briefing.py",
        "learn.py",
        "query-session.py",
        "extract-knowledge.py",
        "build-session-index.py",
        "tentacle.py",
        "checkpoint-diff.py",
        "checkpoint-restore.py",
        "checkpoint-save.py",
        "tests/test_browse_search_v2.py",
    }
    return path in exact or path.startswith(("browse/", "hooks/", "scripts/"))


def check_ruff(staged: list[str]) -> int:
    if not shutil.which("ruff"):
        return 0
    staged_py = [f for f in staged if f.endswith(".py")]
    surface_py = [f for f in staged_py if in_python_cleanliness_surface(f)]
    outside_surface_py = [f for f in staged_py if not in_python_cleanliness_surface(f)]
    if surface_py:
        print("🧹 Checking Python cleanliness (ruff)...")
        result = run(["ruff", "format", "--check", *surface_py], timeout=60)
        if result.returncode != 0:
            print(f"✖ ruff format check failed. Run: ruff format {' '.join(surface_py)}")
            return 1
        result = run(["ruff", "check", *surface_py], timeout=60)
        if result.returncode != 0:
            print("✖ ruff lint check failed. Fix violations above before committing.")
            return 1
    if outside_surface_py:
        try:
            result = run(["ruff", "check", *outside_surface_py], capture_output=True, timeout=60)
        except Exception as exc:
            print(f"[advisory] Ruff scan skipped outside the blocking lint surface: {exc}")
            return 0
        if result.returncode != 0:
            print("[advisory] Ruff found issues outside the blocking lint surface:")
            output = (result.stdout + result.stderr).strip()
            if output:
                print(output)
            print("[advisory] Out-of-surface Ruff findings are non-blocking.")
    return 0


def write_staged_python_snapshot(staged_py: list[str], temp_root: Path) -> tuple[list[str], dict[str, str]]:
    report_paths: list[str] = []
    path_map: dict[str, str] = {}
    for staged_path in staged_py:
        temp_path = temp_root / staged_path
        temp_path.parent.mkdir(parents=True, exist_ok=True)
        temp_path.write_text(staged_content(staged_path), encoding="utf-8", errors="replace")
        report_paths.append(str(temp_path))
        path_map[str(temp_path)] = staged_path
        path_map[temp_path.as_posix()] = staged_path
    return report_paths, path_map


def restore_report_path(value: object, path_map: dict[str, str]) -> str:
    label = str(value or "")
    return path_map.get(label, label)


def restore_error_paths(error: object, path_map: dict[str, str]) -> str:
    message = str(error)
    for temp_path, staged_path in path_map.items():
        message = message.replace(temp_path, staged_path)
    return message


def complexity_advisory_lines(payload: object, path_map: dict[str, str]) -> tuple[list[str], list[str]] | None:
    if not isinstance(payload, dict):
        return None
    files = payload.get("files", [])
    errors = payload.get("errors", [])
    if not isinstance(files, list) or not isinstance(errors, list):
        return None
    advisory_lines: list[str] = []
    for file_info in files:
        if not isinstance(file_info, dict):
            return None
        functions = file_info.get("functions", [])
        if not isinstance(functions, list):
            return None
        path = restore_report_path(file_info.get("path"), path_map)
        if file_info.get("severity") in {"warning", "high"}:
            advisory_lines.append(
                f"  {file_info.get('severity')}: {path} lines={file_info.get('lines')} functions={len(functions)}"
            )
        for fn in functions:
            if not isinstance(fn, dict):
                return None
            if fn.get("severity") not in {"warning", "high"}:
                continue
            advisory_lines.append(
                f"  {fn.get('severity')}: {path}:{fn.get('line')} {fn.get('name')} "
                f"complexity={fn.get('complexity')} lines={fn.get('lines')}"
            )
    return advisory_lines, [restore_error_paths(error, path_map) for error in errors]


def check_complexity(staged: list[str]) -> int:
    if not COMPLEXITY_CHECKER.is_file():
        return 0
    staged_py = [f for f in staged if f.endswith(".py")]
    if not staged_py:
        return 0
    try:
        with tempfile.TemporaryDirectory(prefix="pre-commit-complexity-") as temp_dir:
            report_paths, path_map = write_staged_python_snapshot(staged_py, Path(temp_dir))
            result = run(
                [sys.executable, str(COMPLEXITY_CHECKER), "--json", *report_paths],
                capture_output=True,
                timeout=60,
            )
    except Exception as exc:
        print(f"⚠️ Complexity advisory skipped: {exc}")
        return 0
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        output = (result.stdout + result.stderr).strip()
        if output:
            print("⚠️ Complexity advisory skipped: reporter output was not JSON")
            print(output)
        return 0

    parsed = complexity_advisory_lines(payload, path_map)
    if parsed is None:
        print("⚠️ Complexity advisory skipped: reporter JSON shape was unexpected")
        return 0
    advisory_lines, errors = parsed
    if advisory_lines or errors:
        print("⚠️ Complexity advisory (non-blocking):")
        for line in advisory_lines:
            print(line)
        for error in errors:
            print(f"  reporter-error: {error}")
        print("  Review large/complex functions before committing; this advisory does not block.")
    return 0


def check_prettier(staged: list[str]) -> int:
    supported = (".css", ".js", ".jsx", ".json", ".md", ".ts", ".tsx", ".yaml", ".yml")
    ui_src = [f for f in staged if f.startswith("browse-ui/src/") and f.endswith(supported)]
    if not ui_src:
        return 0
    prettier = Path("browse-ui") / "node_modules" / ".bin" / "prettier"
    if not prettier.is_file():
        return 0
    relative = [f.removeprefix("browse-ui/") for f in ui_src]
    print("🎨 Checking browse-ui/src formatting (Prettier)...")
    result = run(
        [str(Path("node_modules") / ".bin" / "prettier"), "--config", ".prettierrc", "--check", *relative],
        cwd="browse-ui",
        timeout=60,
    )
    if result.returncode != 0:
        print("✖ Prettier check failed. Run: cd browse-ui && pnpm format")
        return 1
    return 0


def check_skill_lint(staged: list[str]) -> int:
    if not LINT_SKILLS.is_file():
        return 0
    staged_skills = [f for f in staged if f.endswith(".agent.md") or f.endswith("SKILL.md")]
    if not staged_skills:
        try:
            run(
                [sys.executable, str(LINT_SKILLS), "--all", "--quiet"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass
        return 0
    print("🔍 Validating skill/agent files...")
    try:
        result = run([sys.executable, str(LINT_SKILLS), "--all", "--fix"], timeout=60)
    except Exception as exc:
        print(exc)
        return 1
    if result.returncode == 1:
        print("")
        print("❌ Commit blocked — fix errors above before committing.")
        print("   Warnings are informational and don't block commits.")
        return 1
    return 0


def main() -> int:
    guard_rc = run_subagent_guard()
    if guard_rc != 0:
        return 1
    staged = staged_files()
    for check in (
        check_inline_styles,
        check_python_syntax,
        check_ruff,
        check_complexity,
        check_prettier,
        check_skill_lint,
    ):
        rc = check(staged)
        if rc != 0:
            return rc
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
