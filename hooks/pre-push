#!/usr/bin/env python3
"""Git pre-push hook: block pushes during active dispatched-subagent work."""

import os
import subprocess
import sys
from pathlib import Path

if os.name == "nt":
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            _stream.reconfigure(encoding="utf-8", errors="replace")

SUBAGENT_CHECK = Path.home() / ".copilot" / "tools" / "hooks" / "check_subagent_marker.py"


def main() -> int:
    if not SUBAGENT_CHECK.is_file():
        return 0
    try:
        result = subprocess.run([sys.executable, str(SUBAGENT_CHECK)], timeout=10)
    except Exception:
        return 0
    return 1 if result.returncode != 0 else 0


if __name__ == "__main__":
    raise SystemExit(main())
