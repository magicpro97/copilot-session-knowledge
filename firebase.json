{
  "hosting": [
    {
      "target": "agents",
      "public": "browse-ui/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "trailingSlash": true,
      "rewrites": [
        {
          "regex": "/sessions/[^/]+(/.*)?",
          "destination": "/sessions/_placeholder/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(ico|png|jpg|jpeg|webp|svg|woff|woff2|ttf|eot)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/chat/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/sessions/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/search/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/insights/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/graph/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/settings/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/diagnostics/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    }
  ]
}
