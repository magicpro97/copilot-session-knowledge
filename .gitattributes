* text=auto eol=lf

# Python / docs / JSON (existing baseline)
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf

# JS / TS / module variants
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Config formats
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Rust + POSIX shell
*.rs text eol=lf
*.sh text eol=lf

# Windows batch / cmd MUST keep CRLF so cmd.exe parses them correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
